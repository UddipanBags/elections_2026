{
  "_comment": "Configuration for wb_results_map.py. Built-in DEFAULTS in the script provide all of these values; you only need to override the ones you want to change. The script falls back to defaults for any key not specified here.",

  "request": {
    "_comment": "Network behaviour for the ECI scrape. Increase delay if you see 403s; bump tls_impersonate if Chrome 124's TLS fingerprint stops working.",
    "delay_seconds":   0.8,
    "tls_impersonate": "chrome124"
  },

  "outputs": {
    "_comment": "Templates substitute {state_slug} (e.g. 'wb', 'tn') and {state_name}.",
    "map_title_template":   "{state_name} Assembly Election 2026 — Leading Party",
    "results_csv_template": "{state_slug}_results.csv",
    "map_html_template":    "{state_slug}_results_map.html"
  },

  "fonts": {
    "_comment": "Font sizes (px) for in-map UI elements at 100% browser zoom. legend_table_px = both the Party/Seats and Margin/buckets tables AND the AC-details card text by default. card_text_px overrides card text size independently of the tables. candidate_popup_px overrides the size of the candidate-list modal that opens on margin-table cell click (defaults to card_text_px). margin_overlay_px = tiny black numbers shown at AC centroids when 'Overlay victory margins' is on.",
    "legend_table_px":    12,
    "card_text_px":       null,
    "candidate_popup_px": null,
    "margin_overlay_px":  9
  },

